    {
        Scanner sc = new Scanner(System.in);
        int choice;
        do{
           System.out.println("1. Check Palindrome"); 
           System.out.println("2. Check Prime"); 
           System.out.println("3. Exit");
           System.out.println("Enter Your Choices");
           choice = sc.nextInt();
 
        }
    }
}