import java.util.*;
import java.time.LocalDate;

class Book {
    int id;
    String title;
    String author;
    boolean issued;

    Book(int id, String title, String author) {
        this.id = id;
        this.title = title;
        this.author = author;
        this.issued = false;
    }

    public String toString() {
        String status = issued ? "Issued" : "Available";

        return "Book ID: " + id +
               " | Title: " + title +
               " | Author: " + author +
               " | Status: " + status;
    }
}

