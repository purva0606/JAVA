import java.util.*;
import java.time.LocalDate;

class Book {
    int id;
    String title;
    String author;
    boolean issued;

    Book(int id, String title, String author) {
        this.id = id;
        this.title = title;
        this.author = author;
        this.issued = false;
    }

    public String toString() {
        String status = issued ? "Issued" : "Available";

        return "Book ID: " + id +
               " | Title: " + title +
               " | Author: " + author +
               " | Status: " + status;
    }
}

// Inheritance
class Member {
    int id;
    String name;

    Member(int id, String name) {
        this.id = id;
        this.name = name;
    }
 public String toString() {
        return "Member ID: " + id + " | Name: " + name;
    }
}

